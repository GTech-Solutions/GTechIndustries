{
    "name": "cloud-gaze",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/cloud-gaze/src",
    "projectType": "library",
    "tags": [],
    "targets": {
      "build": {
        "executor": "@nx/rollup:rollup",
        "outputs": ["{options.outputPath}"],
        "options": {
          "outputPath": "dist/libs/cloud-gaze",
          "tsConfig": "libs/cloud-gaze/tsconfig.lib.json",
          "project": "libs/cloud-gaze/package.json",
          "entryFile": "libs/cloud-gaze/src/index.ts",
          "external": ["@gtech/shared-components","react", "react-dom", "react/jsx-runtime"],
          "rollupConfig": "@nx/react/plugins/bundle-rollup",
          "compiler": "babel",
          "assets": [
            {
              "glob": "libs/cloud-gaze/README.md",
              "input": ".",
              "output": "."
            }
          ]
        }
      }
    }
}
